# ProseForge TTS Worker — Environment Variables
#
# Copy to .env and fill in values for local development.
# RunPod serverless sets RUNPOD_* variables automatically.

# --- Local dev ---
# PORT=8090
# MODELS_DIR=models
# DATA_DIR=data
# ONNX_LIBRARY_PATH=/opt/homebrew/lib/libonnxruntime.dylib

# --- RunPod serverless (set automatically) ---
# RUNPOD_WEBHOOK_GET_JOB=
# RUNPOD_WEBHOOK_POST_OUTPUT=
# RUNPOD_WEBHOOK_PING=
# RUNPOD_PING_INTERVAL=4000
# RUNPOD_POD_ID=
# RUNPOD_AI_API_KEY=
